NTFY_TOPIC=REDACTED_SET_ME

REPOS=(
  "$HOME/repos/roosterclawbox|heymckay-cpu/roosterclawbox"
  "/home/clawbox/repos/prism|heymckay-cpu/prism"
  "/home/clawbox/repos/Cashflowpro|heymckay-cpu/Cashflowpro"
)

LABEL="agent-ready"
DEFAULT_BRANCH="main"
TEST_CMD="true"

SLEEP_BETWEEN=900
MAX_TURNS=120
TIMEOUT="75m"
LOG_DIR="$HOME/agent-logs"
KILL_SWITCH="/etc/agent-paused"

TRIAGE_ENABLED=0
export TRIAGE_MODEL="qwen2.5:3b-instruct-q4_K_M"
export OLLAMA_URL="http://localhost:11434"

# Project Prism settings
export PRISM_REPO_DIR="/home/clawbox/repos/prism"
export PRISM_REPO_SLUG="heymckay-cpu/prism"
export PRISM_MAX_ACTIVE=3
